%{
let reductions : Ref[Int] = Ref(0)
%}

%position<Int>
%token<Int> NUMBER
%token EQ NE LPAREN RPAREN
%nonassoc EQ NE
%start<Int> start
%type<Int> expr

%%

start: expr { $1 };

expr:
  | NUMBER { $1 }
  | expr EQ expr { reductions.val += 1; $1 + $3 }
  | expr NE expr { reductions.val += 1; $1 + $3 }
  | LPAREN expr RPAREN { $2 };
