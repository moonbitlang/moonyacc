import {
  "moonbitlang/yacc/ast",
  "moonbitlang/core/list",
}

formatter(ignore: [ "parser.mbt" ])

rule(
  name: "moonyacc",
  command: "moon --target-dir $mod_dir/_build/bootstrap-tool run --target wasm $mod_dir/internal/bootstrap_parser -- --input-mode array $input -o $output",
)

dev_build(rule: "moonyacc", input: "parser.mbty", output: "parser.mbt")
